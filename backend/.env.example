# Copie para backend/.env. Preserve as chaves usadas no dispositivo e no app.
# Obrigatorias: diferentes, minimo 24 caracteres cada.
CHARGESENSE_DEVICE_KEY=1246a7255c416f8bd93971fbbaac7c65f73a32d5de91a49a
CHARGESENSE_READ_KEY=cc14f11a0995f9c11608311edc7993b97689a8af664df600
CHARGESENSE_STATION_ID=bancada-01

# Cole seus tres limites crescentes: atencao, alerta, critico.
# Valores vazios desabilitam os alertas daquela grandeza.
CHARGESENSE_VOLTAGE_LEVELS=7,9,11
CHARGESENSE_CURRENT_LEVELS=0.30,0.40,0.50
CHARGESENSE_VOLTAGE_HYSTERESIS=0
CHARGESENSE_CURRENT_HYSTERESIS=0
CHARGESENSE_ALERT_HOLD_SECONDS=0

# Opcional: apenas se habilitou seguranca adicional de push no Expo.
# CHARGESENSE_EXPO_ACCESS_TOKEN=

# Opcional: sem esta variavel, usa backend/data/chargesense.db.
# Prefira caminho absoluto; no Windows use barras /.
# CHARGESENSE_DB=C:/caminho/chargesense.db
